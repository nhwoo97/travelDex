# MongoDB Atlas connection string. Use a database name such as /traveldex.
DB_URL=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/traveldex?retryWrites=true&w=majority

# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Cloudinary Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Mapbox public access token (pk.*). Restrict it to your deployed site domain in Mapbox.
MAPBOX_TOKEN=
