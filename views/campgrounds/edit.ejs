<% layout('layouts/boilerplate') %>
<div class="row">
  <div class="col-lg-7 col-xl-6 mx-auto">
    <h1 class="mb-4">Edit place</h1>
    <form action="/places/<%= campground._id %>?_method=PUT" method="POST" novalidate class="validated-form" enctype="multipart/form-data">
      <%- include('../partials/placeFields', { place: campground }) %>
      <div class="mb-3">
        <label class="form-label" for="image">Add photos</label>
        <input type="file" class="form-control" id="image" name="image" accept="image/jpeg,image/png,image/webp" multiple />
        <div class="form-text">JPEG, PNG or WebP · up to 8 photos, 5 MB each.</div>
      </div>
      <% if (campground.images.length) { %>
        <fieldset class="mb-4">
          <legend class="form-label fs-6">Current photos — tick any to delete</legend>
          <div class="d-flex flex-wrap gap-3">
            <% campground.images.forEach((img, i) => { %>
              <label class="photo-delete" for="image-<%= i %>">
                <img src="<%= imageUrl(img, "c_fill,w_160,h_120") %>" class="img-thumbnail" alt="Photo <%= i + 1 %>" />
                <span class="form-check mt-1"><input class="form-check-input" type="checkbox" id="image-<%= i %>" name="deleteImages[]" value="<%= img.filename %>" /> <span class="small">Delete</span></span>
              </label>
            <% }) %>
          </div>
        </fieldset>
      <% } %>
      <button class="btn btn-primary">Save changes</button>
      <a class="btn btn-link" href="/places/<%= campground._id %>">Cancel</a>
    </form>
  </div>
</div>
