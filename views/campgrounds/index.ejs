<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/index.css" />
<div id="map" class="bigMap"></div>
<h1>All Locations</h1>
<% for (const campground of campgrounds) { %>
  <div class="card mb-4"><div class="row">
    <div class="col-md-4">
      <% if (campground.images.length) { %><img class="img-fluid" src="<%= campground.images[0].url %>" alt="<%= campground.title %>" /><% } %>
    </div>
    <div class="col-md-8"><div class="card-body">
      <h5 class="card-title"><%= campground.title %></h5>
      <p class="card-text"><%= campground.description %></p>
      <p class="card-text"><small class="text-muted"><%= campground.location %></small></p>
      <a class="btn btn-primary" href="/campgrounds/<%= campground._id %>">View <%= campground.title %></a>
    </div></div>
  </div></div>
<% } %>
<script>
  const mapToken = <%- JSON.stringify(mapToken).replace(/</g, "\\u003c") %>;
  const campgroundsData = <%- JSON.stringify({
    type: "FeatureCollection",
    features: campgrounds.filter(c => c.geometry && c.geometry.coordinates).map(c => ({
      type: "Feature", geometry: c.geometry,
      properties: { title: c.title, description: c.description.slice(0, 120), url: `/campgrounds/${c._id}` }
    }))
  }).replace(/</g, "\\u003c") %>;
</script>
<script src="/javascripts/clusterMap.js"></script>
