<% layout('layouts/boilerplate') %>
<div class="row">
  <div class="col-lg-7 col-xl-6 mx-auto">
    <h1 class="mb-4">Add a place</h1>
    <form action="/places" method="POST" novalidate class="validated-form" enctype="multipart/form-data">
      <%- include('../partials/placeFields', { place: null }) %>
      <div class="mb-4">
        <label class="form-label" for="image">Photos</label>
        <input type="file" class="form-control" id="image" name="image" accept="image/jpeg,image/png,image/webp" multiple />
        <div class="form-text">JPEG, PNG or WebP · up to 8 photos, 5 MB each. The first photo is the cover.</div>
      </div>
      <button class="btn btn-success">Add place</button>
      <a class="btn btn-link" href="/places">Cancel</a>
    </form>
  </div>
</div>
