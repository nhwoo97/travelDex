<% layout('layouts/boilerplate') %>
<section class="home-hero text-white text-center d-flex align-items-center mb-5">
  <div class="container py-5">
    <h1 class="display-4 fw-bold">Find your next favorite place</h1>
    <p class="lead mb-4">Real spots shared and reviewed by travelers<% if (placeCount) { %> · <%= placeCount %> <%= placeCount === 1 ? "place" : "places" %> and counting<% } %>.</p>
    <form class="row g-2 justify-content-center" action="/places" method="GET" role="search">
      <div class="col-12 col-md-6"><input class="form-control form-control-lg" type="search" name="q" placeholder="Try “tokyo”, “ramen” or “hike”" aria-label="Search places" maxlength="100" /></div>
      <div class="col-12 col-md-auto d-grid"><button class="btn btn-light btn-lg" type="submit">Search</button></div>
    </form>
    <div class="mt-4 d-flex flex-wrap justify-content-center gap-2">
      <% for (const category of CATEGORIES.filter(c => c.key !== "other")) { %>
        <a class="btn btn-sm btn-outline-light rounded-pill" href="<%= listingUrl({ category: category.key }) %>"><%= category.icon %> <%= category.label %></a>
      <% } %>
    </div>
  </div>
</section>

<div class="container">
  <% if (topRated.length) { %>
    <section class="mb-5">
      <div class="d-flex justify-content-between align-items-baseline mb-3">
        <h2 class="h3 mb-0">Top rated</h2>
        <a href="<%= listingUrl({ sort: "top" }) %>">See all →</a>
      </div>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        <% for (const place of topRated) { %><div class="col"><%- include('partials/placeCard', { place }) %></div><% } %>
      </div>
    </section>
  <% } %>

  <section class="mb-5">
    <div class="d-flex justify-content-between align-items-baseline mb-3">
      <h2 class="h3 mb-0">Recently added</h2>
      <a href="/places">See all →</a>
    </div>
    <% if (recent.length) { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
        <% for (const place of recent) { %><div class="col"><%- include('partials/placeCard', { place }) %></div><% } %>
      </div>
    <% } else { %>
      <p class="text-muted">No places yet. <a href="/places/new">Share the first one</a>.</p>
    <% } %>
  </section>

  <% if (!currentUser) { %>
    <section class="text-center p-5 bg-light rounded mb-4">
      <h2 class="h4">Been somewhere worth sharing?</h2>
      <p class="text-muted">Create a free account to add places, leave reviews and keep a want-to-go list.</p>
      <a class="btn btn-success" href="/register">Join TravelDex</a>
    </section>
  <% } %>
</div>
