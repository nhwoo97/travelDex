<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/stars.css" />
<div class="row">
  <div class="col-lg-6 col-xl-5 mx-auto">
    <h1 class="h3 mb-1">Edit your review</h1>
    <p class="text-muted mb-4">for <a href="/places/<%= campground._id %>"><%= campground.title %></a></p>
    <form action="/places/<%= campground._id %>/reviews/<%= review._id %>?_method=PUT" method="POST" class="validated-form" novalidate>
      <%- include('../partials/ratingInput', { selected: review.rating }) %>
      <div class="mb-3">
        <label class="form-label" for="body">Your review</label>
        <textarea class="form-control" name="review[body]" id="body" rows="5" maxlength="2000" required><%= review.body %></textarea>
      </div>
      <button class="btn btn-primary">Save review</button>
      <a class="btn btn-link" href="/places/<%= campground._id %>#review-<%= review._id %>">Cancel</a>
    </form>
  </div>
</div>
